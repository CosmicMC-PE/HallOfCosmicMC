{
    "name": "cosmicorg/halloftop",
    "description": "PocketMine-MP plugin that displays NPCs showcasing your server's Top 1 players (Kills, Money, Playtime)",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "^5.47",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "": "src/"
        }
    },
    "scripts": {
        "analyze": "@php vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
